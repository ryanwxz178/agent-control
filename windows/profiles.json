    "busy": "^(停止|停止生成|停止回答|Stop|Stop generating)$",
    "complete": "^(朗读|朗读全文|Read aloud)$",
    "chatId": "",
    "editorId": "",
    "blank": "^(有什么(?:我能|可以)帮.*|今天有什么可以帮.*|和豆包聊聊.*|How can I help.*)$",
    "windowTitle": "(^豆包$| - 豆包$)",
    "placeholder": "^发消息或按住空格说话\\.\\.\\.$",
    "launchArgs": [
      "--force-renderer-accessibility=complete",
      "--enable-features=UiaProvider"
    ],
    "sendClass": "(?:^| )!?bg-g-send-msg-btn-bg(?: |$)",
    "replyDecorationClass": "(?s)^(?=.*(?:^|\\s)self-center(?:\\s|$))(?=.*(?:^|\\s)whitespace-nowrap(?:\\s|$))(?=.*(?:^|\\s)text-dbx-text-secondary(?:\\s|$))(?=.*(?:^|\\s)mr-14(?:\\s|$)).*$"
  },
  "teleagent": {
    "processNames": ["TeleAgent"],
    "windowTitle": "^TeleAgent$",
    "newChat": "^新建任务$",
    "send": "^运行$",
    "busy": "^(停止|停止生成|停止执行|停止任务|Stop|Stop generating)$",
    "complete": "^已完成本轮思考与执行(?: .*)?$",
    "blank": "^Shift/Ctrl \\+ Enter 换行，Enter 发送$",
