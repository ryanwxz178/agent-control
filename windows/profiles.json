{
  "workbuddy": {
    "taskbarId": "Appid: WorkBuddy.WorkBuddy",
    "processNames": [
      "WorkBuddy"
    ],
    "newChat": "^(新建任务|新对话|New task|New chat)$",
    "send": "^(发送|发送消息|Send|Send message)$",
    "busy": "^(停止|停止生成|停止回答|Stop|Stop generating)$",
    "complete": "^(已完成([，,， ].*)?|任务完成|Task completed|Completed)$",
    "chatId": "",
    "editorId": "",
    "chatEditorParent": true,
    "messageCopyScope": true,
    "fileUploads": true,
    "fileMenuClass": "(?:^| )cr-add-menu__trigger(?: |$)",
    "fileMenuSteps": [
      {"name": "^(添加文件|新增檔案|Add Files)$", "hover": true},
      {"name": "^(本地文件|本機檔案|Local files)$", "className": "(?:^| )cr-files-submenu__item(?: |$)"}
    ],
    "fileTagClass": "(?:^| )_fileTag_[A-Za-z0-9]+_\\d+(?: |$)",
    "filePendingClass": "(?:^| )_(?:uploading|failed)_[A-Za-z0-9]+_\\d+(?: |$)",
    "fileExtensions": ["png","jpg","jpeg","webp","gif","pdf","txt","md","json","jsonl","xml","yaml","yml","csv","tsv","log","doc","docx","xls","xlsx","ppt","pptx","bmp","svg","zip","js","ts","jsx","tsx","py","go","java","cpp","c","h","css","scss","html"],
    "blank": "^(WorkBuddy, 我帮你|今天帮你做些什么.*|你想完成什么.*|有什么可以帮.*|开始新任务.*|What would you like.*|How can I help.*)$",
    "launchArgs": [
      "--force-renderer-accessibility=complete",
      "--enable-features=UiaProvider"
    ],
    "windowTitle": "^WorkBuddy$",
    "placeholder": "^今天帮你做些什么？@ 添加上下文，/调用技能与指令$",
    "replyAfterComplete": true,
    "replyEndClass": "(?:^| )_copyButton_[A-Za-z0-9]+_\\d+(?: |$)"
  },
  "doubao": {
    "processNames": [
      "Doubao"
    ],
    "newChat": "^(新对话(?: Ctrl Shift K)?|开启新对话|New chat)$",
